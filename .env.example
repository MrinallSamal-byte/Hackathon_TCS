# CampusBite env template — copy to .env locally; on Vercel paste these
# into Project Settings → Environment Variables (NEVER commit real keys).
#
# AI (optional — app is fully rule-based without it)
OPENROUTER_API_KEY=
# OPENROUTER_MODELS="nex-agi/nex-n2.5-mini:free,liquid/lfm-2.5-2.6b:free"
# LLM timeouts (keep UNDER your host's function limit; Vercel Hobby = 10 s)
OPENROUTER_TIMEOUT=8
OPENROUTER_CHAIN_BUDGET=8
#
# Database (REQUIRED on serverless — /tmp forgets everything between calls)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role key>
# SUPABASE_ANON_KEY=<anon key, if you prefer it for reads>
#
# Writable runtime dir (local default ./data; serverless auto-uses /tmp;
# override only if you need a custom path)
# CAMPUSBITE_DATA_DIR=/tmp/campusbite-data
#
# CORS (comma-separated allowed origins; default "*" with no credentials)
# CAMPUSBITE_CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
#
# Admin guard (recommended in prod — when set, every /admin/* needs
# header X-Admin-Token: <token>; frontend reads it from localStorage
# key cb_admin_token)
# ADMIN_API_TOKEN=<long-random-token>
#
# Frontend (set at BUILD time on the frontend project)
# VITE_API_URL=https://<your-backend>.vercel.app
